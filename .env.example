# Copy to .env (git-ignored). Real environment variables take precedence over this file.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Set to 1 to allow live Nemotron calls from the Studio (also needs the key above). Any other value keeps them off.
CREATURE_FORGE_ENABLE_LIVE=
